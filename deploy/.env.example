# Copy to deploy/.env on the server

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@supabase-db:5432/postgres

# Auth (generate: openssl rand -base64 32)
AUTH_SECRET=change-me-min-32-characters-long-secret
APP_ENCRYPTION_KEY=change-me-encryption-key-for-api-keys

# OpenAI fallback when user has no personal key in Settings
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# n8n integration (workflow provisioning + internal config API)
N8N_API_URL=https://orc.momoh.de/api/v1
N8N_API_KEY=
N8N_INTERNAL_SECRET=change-me-n8n-internal-secret
N8N_WEB_CONFIG_URL=https://jobs.mubu.dev
N8N_TEMPLATE_FINDER_WORKFLOW_ID=ROTREzXrgqrC8ffZ
N8N_TEMPLATE_ANALYZER_WORKFLOW_ID=inw6qMHWkng6OdKs

# Canva Connect (https://www.canva.com/developers/) — redirect: {APP_URL}/api/canva/callback
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
APP_URL=https://jobs.mubu.dev

# Comma-separated accounts with no daily manual-run limit (for testing/admin)
MANUAL_RUN_UNLIMITED_EMAILS=admin@jobs.local
# MANUAL_RUN_UNLIMITED_USER_IDS=uuid-here
