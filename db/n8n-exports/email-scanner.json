        "language": "javaScript",
        "jsCode": "return [{\n  json: {\n    message: 'Configure IMAP in web settings, then use /api/email/sync',\n    settings_id: $input.first().json.id\n  }\n}];"
      }
    },
    {
      "id": "e13c26e1-18ab-45b9-b3c5-29f4d3691af4",
      "name": "Update last scan skipped",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        896,
        368
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE email_settings\nSET last_scan_at = timezone('utc', now()),\n    last_scan_status = 'skipped',\n    last_scan_error = 'IMAP not configured',\n    updated_at = timezone('utc', now())\nWHERE id = $1\nRETURNING id, last_scan_status;",
        "options": {
          "queryReplacement": "={{ [$json.settings_id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "name": "Postgres account"
        }
      }
    }
