    {
      "id": "bfe44238-e60d-4636-8436-15bfc6cc93de",
      "name": "Get email settings",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        224,
        288
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, imap_host, imap_port, imap_user, imap_password, imap_secure, scan_enabled\nFROM email_settings\nWHERE scan_enabled = true\nORDER BY created_at\nLIMIT 1;"
      },
      "credentials": {
        "postgres": {
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "b5269939-e43e-4b6f-9c93-dc7a4834549e",
      "name": "Has IMAP config?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        448,
        288
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.imap_host }}",
              "operator": {
