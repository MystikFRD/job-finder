              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            },
            {
              "leftValue": "={{ $json.imap_password }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ]
        }
      }
    },
    {
      "id": "bed03a22-4dda-4cb7-8794-7586ae5cef6b",
      "name": "IMAP sync via web app",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        672,
        176
      ],
      "parameters": {
        "method": "POST",
        "url": "https://YOUR_DOMAIN/api/n8n/email-sync",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Secret",
              "value": "YOUR_N8N_INTERNAL_SECRET"
            }
          ]
        },
        "options": {}
      },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "id": "3468e1ff-1f4a-4efc-926c-fe94e8dde3ca",
      "name": "Expand emails for classify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        176
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const settings = $('Get email settings').first().json;\nconst sync = $input.first().json || {};\nconst emails = Array.isArray(sync.emails) ? sync.emails : [];\nreturn emails.map((e) => ({\n  json: {\n    settings_id: settings.id,\n    imap_user: settings.imap_user,\n    message_id: e.messageId || e.message_id || null,\n    from: e.from || '',\n    subject: e.subject || '',\n    body: e.body || '',\n    received_at: e.receivedAt || e.received_at || null\n  }\n}));"
      }
    },
    {
      "id": "b1b4ca7a-2d6d-461e-a6b1-93cd06f0edb9",
      "name": "Update last scan success",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1344,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE email_settings\nSET last_scan_at = timezone('utc', now()),\n    last_scan_status = 'success',\n    last_scan_error = NULL,\n    updated_at = timezone('utc', now())\nWHERE id = $1\nRETURNING id, last_scan_at, last_scan_status;",
        "options": {
          "queryReplacement": "={{ [$(' + \"'Get email settings'\" + ').first().json.id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "1e7c7612-4d36-4209-865d-cc18039b9d07",
      "name": "Classify email",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.1,
      "position": [
        1344,
        192
      ],
      "parameters": {
        "resource": "chat",
        "operation": "complete",
        "model": "gpt-4o-mini",
        "prompt": {
          "messages": [
            {
              "role": "system",
              "content": "Classify recruiting/application emails. Respond with JSON only: {\"category\":\"...\",\"confidence\":0.0,\"summary\":\"...\",\"suggested_action\":\"...\"}. Categories: application_received, rejection, interview_invitation, request_for_information, assessment_invitation, technical_test, follow_up, offer, generic_recruiting_email, unknown. Use application_received for receipt confirmations (Eingangsbestätigung / Empfangsbestätigung / auto-replies) that only confirm the application or email arrived, with no hiring decision. Typical signals: Eingangsbestätigung, Empfangsbestätigung, Wir haben Ihre Bewerbung erhalten, Ihre Bewerbung ist bei uns eingegangen, Vielen Dank für Ihre Bewerbung without absage/interview/offer, we have received your application, application received. If the same email confirms receipt AND rejects, invites, or offers, use that decision category. Never classify a pure Eingangsbestätigung as generic_recruiting_email, follow_up, or unknown."
            },
            {
              "role": "user",
              "content": "={{ \"From: \" + $json.from + \"\\nSubject: \" + $json.subject + \"\\n\\n\" + String($json.body || \"\").slice(0, 4000) }}"
            }
          ]
        },
        "options": {
          "temperature": 0.2,
          "maxTokens": 300
        }
      },
      "credentials": {
        "openAiApi": {
          "name": "OpenAI account"
        }
      }
    },
    {
      "id": "63603896-d73e-4910-9ea3-c7df834dbb8b",
      "name": "Parse classification JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        192
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const email = $('Each email').item.json;\nconst raw = $json.message?.content || $json.text || $json.content || '';\nlet parsed = { category: 'unknown', confidence: 0.5 };\ntry {\n  const text = String(raw).trim().replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/i, '').trim();\n  const start = text.indexOf('{');\n  const end = text.lastIndexOf('}');\n  if (start !== -1 && end !== -1) parsed = JSON.parse(text.slice(start, end + 1));\n} catch (e) {}\nconst aliases = {\n  eingangsbestaetigung: 'application_received',\n  empfangsbestaetigung: 'application_received',\n  zustellbestaetigung: 'application_received',\n  lesebestaetigung: 'application_received',\n  receipt_confirmation: 'application_received',\n  receipt: 'application_received',\n  acknowledgement: 'application_received',\n  acknowledgment: 'application_received',\n  auto_reply: 'application_received',\n};\nconst folded = String(parsed.category || 'unknown').toLowerCase().trim().replace(/ä/g, 'ae').replace(/ö/g, 'oe').replace(/ü/g, 'ue').replace(/ß/g, 'ss').replace(/[\\s-]+/g, '_');\nconst category = aliases[folded] || parsed.category || 'unknown';\nreturn {\n  json: {\n    settings_id: email.settings_id,\n    message_id: email.message_id,\n    from: email.from,\n    imap_user: email.imap_user,\n    subject: email.subject,\n    body: email.body,\n    received_at: email.received_at,\n    category,\n    confidence: Number(parsed.confidence ?? 0.5)\n  }\n};"
      }
    },
    {
      "id": "f0155618-ab2d-42be-9b31-638ad62d3b08",
      "name": "Store classified email",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1792,
        224
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id FROM store_classified_email($1, $2, $3, $4, $5, $6, $7, $8, NULL);",
        "options": {
          "queryReplacement": "={{ [$json.message_id, $json.from, $json.imap_user, $json.subject, String($json.body || \"\").slice(0, 50000), $json.received_at, $json.category, $json.confidence] }}"
        }
      },
      "onError": "continueRegularOutput",
      "credentials": {
        "postgres": {
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "0534e3d1-5306-4dfb-97a9-1e0301bad8a4",
      "name": "Each email",
